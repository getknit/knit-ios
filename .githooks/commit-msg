#!/bin/sh
# Strip Claude Code session-link trailers before they can enter history.
#
# The agent harness asks its models to end commit messages with a
# "Claude-Session: https://claude.ai/code/session_..." line. This repository never wants it: it is
# per-session noise, and it leaks a session handle into a public mirror. Co-Authored-By is kept.
#
# Active once `git config core.hooksPath .githooks` is set; `git commit --no-verify` skips it once.
msg="$1"
tmp="$msg.session-strip"
grep -v -E '^[[:space:]]*Claude-Session:[[:space:]]*https://claude\.ai/code/session_' "$msg" > "$tmp" 2>/dev/null || true
if [ -s "$tmp" ]; then
	mv "$tmp" "$msg"
else
	rm -f "$tmp"
fi
exit 0
