<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Knit</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.getknit.knit.contact</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>knit</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>KnitAppGroup</key>
	<string>$(KNIT_APP_GROUP)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Knit uses Bluetooth to find people nearby and pass messages from phone to phone, so you can chat without internet or cell service.</string>
	<key>NSCameraUsageDescription</key>
	<string>Knit uses the camera to scan the code on someone's phone, so you can add them as a contact or check that no one is intercepting your direct messages with them.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Knit saves a photo from a chat to your library when you tap Save. It can't see your photos.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
